# `openssl rand -hex 32` ile üretin. Bu örnek değer uygulama tarafından reddedilir.
APP_SECRET_KEY=replace-with-a-long-random-value
APP_BASE_URL=http://localhost:8000
ADMIN_USERNAME=admin
# Yeni kurulumda hesap tarayıcıda oluşturulur; boş bırakın.
ADMIN_PASSWORD_HASH=
# make setup otomatik üretir; mevcut kurulumda make setup-key kullanın.
SETUP_TOKEN=
DOWNLOAD_DIR=storage/downloads
