# Generate this with `openssl rand -hex 32`. The example value is rejected.
APP_SECRET_KEY=replace-with-a-long-random-value
APP_BASE_URL=http://localhost:8000
ADMIN_USERNAME=admin
# Create the account in the browser during setup; leave this empty for new sites.
ADMIN_PASSWORD_HASH=
# `make setup` generates this automatically; use `make setup-key` on existing sites.
SETUP_TOKEN=
DOWNLOAD_DIR=storage/downloads
# Private encrypted archives, never inside a publicly served directory.
BACKUP_DIR=storage/backups
# Maximum unencrypted archive/import size; browser imports require this much memory.
MAX_BACKUP_SIZE_MB=1024
